amends "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Config.pkl"

// Builtins.gitleaks runs `gitleaks dir .`, which scans the working tree
// including gitignored files like local/ and .env. These steps scan what git
// will actually publish: the staged diff on commit, history on check and push.
local gitleaks_staged = new Step {
  check = new CommandSpec {
    command = "gitleaks git --staged --no-banner"
    effect = "read"
  }
}

local gitleaks_history = new Step {
  check = new CommandSpec {
    command = "gitleaks git --no-banner"
    effect = "read"
  }
}

// Patterns live in .forbidden-patterns; private literals live in the
// gitignored local/forbidden-strings.
local forbidden_files = new Step {
  check = new CommandSpec {
    command = "scripts/check-forbidden {{files}}"
    effect = "read"
  }
}

local forbidden_tree = new Step {
  check = new CommandSpec {
    command = "scripts/check-forbidden"
    effect = "read"
  }
}

local cargo_fmt = new Step {
  check = new CommandSpec {
    command = "cargo fmt --check"
    effect = "read"
  }
}

local cargo_clippy = new Step {
  check = new CommandSpec {
    command = "cargo clippy --all-targets -- -D warnings"
    effect = "read"
  }
}

local shellcheck = new Step {
  check = new CommandSpec {
    command = "shellcheck puller/pull.sh puller/pull.test.sh puller/fetch-report.sh puller/fetch-report.test.sh scripts/check-forbidden scripts/image-smoke scripts/deploy scripts/compose-config-check checks/collect checks/puller-age checks/stack-health checks/puller-age.test.sh checks/stack-health.test.sh checks/collect.test.sh scripts/install-host-state scripts/install-host-state.test.sh scripts/host-state-dry-run scripts/fence-line scripts/fence-line.test.sh"
    effect = "read"
  }
}

local compose_config = new Step {
  check = new CommandSpec {
    command = "scripts/compose-config-check"
    effect = "read"
  }
}

hooks {
  ["pre-commit"] {
    steps {
      ["fmt"] = cargo_fmt
      ["gitleaks"] = gitleaks_staged
      ["forbidden"] = forbidden_files
      ["shellcheck"] = shellcheck
    }
  }
  ["check"] {
    steps {
      ["fmt"] = cargo_fmt
      ["clippy"] = cargo_clippy
      ["gitleaks"] = gitleaks_history
      ["forbidden"] = forbidden_tree
      ["shellcheck"] = shellcheck
      ["compose"] = compose_config
    }
  }
  ["pre-push"] {
    steps {
      ["clippy"] = cargo_clippy
      ["gitleaks"] = gitleaks_history
      ["forbidden"] = forbidden_tree
    }
  }
}
