# References, not secrets: `op run --env-file` resolves them at deploy time
# (scripts/deploy). Nothing here is a credential.
BRINED_ALMANAC_GITHUB_TOKEN=op://brined-almanac/github-token/token
BRINED_ALMANAC_GITHUB_ALERTS_TOKEN=op://brined-almanac/github-alerts-token/token
BRINED_ALMANAC_PULLER_KEY="op://brined-almanac/puller/private key?ssh-format=openssh"
BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=op://brined-almanac/taskchampion/client_id
BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=op://brined-almanac/taskchampion/encryption_secret
