#!/usr/bin/env bash
# Asserts compose.prod.yaml renders the intended stack, using stub values only.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

printf 'ALMANAC_MODE=live\nPULL_HOST=h\nPULL_USER=u\nTASKCHAMPION_SYNC_URL=https://example.invalid\n' >"$tmp/prod.env"
: >"$tmp/known_hosts"
mkdir "$tmp/transcripts"

render() {
  env -u BRINED_ALMANAC_GITHUB_TOKEN -u BRINED_ALMANAC_PULLER_KEY -u BRINED_ALMANAC_TIERS_SHA256 \
    -u BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID -u BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET \
    -u COMPOSE_PROJECT_NAME BRINED_ALMANAC_STATE="$tmp" "$@" \
    docker compose -f compose.prod.yaml config --format json
}

rendered=$(render BRINED_ALMANAC_GITHUB_TOKEN=x BRINED_ALMANAC_PULLER_KEY=y BRINED_ALMANAC_TIERS_SHA256=h \
  BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=c BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=s)

jq -e '
  .name == "brined-almanac-prod"
  and .services.db.ports == null
  and .services.almanac.environment.DATABASE_URL == "postgres://almanac@db:5432/almanac"
  and .services.almanac.environment.BRENT_TRANSCRIPTS == "/transcripts"
  and .services.almanac.environment.TASKCHAMPION_CLIENT_ID == "c"
  and .services.almanac.environment.TASKCHAMPION_ENCRYPTION_SECRET == "s"
  and .services.almanac.environment.TASKCHAMPION_SYNC_URL == "https://example.invalid"
  and ([.services.almanac.volumes[] | select(.target == "/var/lib/brined-almanac/taskchampion")] | length == 1)
  and ([.services.almanac.volumes[] | select(.target == "/transcripts")] | length == 1 and .[0].read_only == true)
  and .services.almanac.environment.LOCAL_TIERS == "/etc/brined-almanac/tiers.toml"
  and ([.services.almanac.volumes[] | select(.target == "/etc/brined-almanac/tiers.toml")] | length == 1 and .[0].read_only == true)
  and .services.almanac.environment.LOCAL_TIERS_SHA256 == "h"
  and .services.almanac.ports[0].published == "8788"
  and .services.almanac.ports[0].host_ip == "127.0.0.1"
  and .services.puller.environment.PULLER_KEY == "y"
  and ([.services.puller.tmpfs[]? | select(startswith("/run/puller:") and contains("uid=10002"))] | length == 1)
  and ([.services.backup.volumes[] | select(.target == "/backups")] | length == 1)
  and .services.backup.healthcheck.test != null
' >/dev/null <<<"$rendered" || {
  echo "compose-config-check: rendered config failed an assertion" >&2
  exit 1
}

guarded=(GITHUB_TOKEN PULLER_KEY TIERS_SHA256 TASKCHAMPION_CLIENT_ID TASKCHAMPION_ENCRYPTION_SECRET)

# Renders with every guarded secret but one.
expect_guard_failure() {
  local missing=$1 name err present=()
  for name in "${guarded[@]}"; do
    [[ $name == "$missing" ]] || present+=("BRINED_ALMANAC_$name=x")
  done
  if err=$(render "${present[@]}" 2>&1 >/dev/null); then
    echo "compose-config-check: config succeeded without BRINED_ALMANAC_$missing" >&2
    exit 1
  fi
  grep -q 'mise run deploy' <<<"$err" || {
    echo "compose-config-check: missing BRINED_ALMANAC_$missing did not point at mise run deploy" >&2
    exit 1
  }
}

# ps and exec interpolate the whole file too; dummy values must be enough for them.
render BRINED_ALMANAC_GITHUB_TOKEN=unused BRINED_ALMANAC_PULLER_KEY=unused BRINED_ALMANAC_TIERS_SHA256=unused \
  BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=unused BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=unused >/dev/null || {
  echo "compose-config-check: dummy guard values do not render, so ps/exec would fail" >&2
  exit 1
}
env -u COMPOSE_PROJECT_NAME BRINED_ALMANAC_STATE="$tmp" BRINED_ALMANAC_GITHUB_TOKEN=unused BRINED_ALMANAC_PULLER_KEY=unused BRINED_ALMANAC_TIERS_SHA256=unused \
  BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=unused BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=unused \
  docker compose -f compose.prod.yaml ps >/dev/null

for name in "${guarded[@]}"; do
  expect_guard_failure "$name"
done

echo "compose-config-check: ok"
