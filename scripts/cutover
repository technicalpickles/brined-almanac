#!/usr/bin/env bash
# Resolves history in prod Bugsink at the cutover (docs/superpowers/plans/2026-11-09-cutover.md).
# A dry run by default. `scripts/cutover --apply` resolves and comments.
set -euo pipefail
if [[ -z ${BRINED_ALMANAC_OP_TOKEN:-} ]]; then
  if [[ -n ${BRINED_ALMANAC_AV_REEXEC:-} ]]; then
    echo "cutover: av inject ran but set no BRINED_ALMANAC_OP_TOKEN" >&2
    exit 1
  fi
  export BRINED_ALMANAC_AV_REEXEC=1
  exec av inject +BRINED_ALMANAC_OP_TOKEN -- "$0" "$@"
fi
cd "$(dirname "$0")/.."
cargo build -q
OP_SERVICE_ACCOUNT_TOKEN=$BRINED_ALMANAC_OP_TOKEN op run --env-file cutover.secrets.env -- target/debug/brined-almanac cutover "$@"
