#!/usr/bin/env bash
# Build both images and start or update the prod stack. --db-only starts just
# Postgres (the first deploy, before the secrets exist in 1Password).
set -euo pipefail

runbook=docs/runbooks/prod-on-the-mac.md
db_only=0
allow_pending=0
tag=
args=("$@")

while [[ $# -gt 0 ]]; do
  case $1 in
    --db-only) db_only=1 ;;
    --allow-pending) allow_pending=1 ;;
    --tag)
      tag=${2:?deploy: --tag needs a value}
      shift
      ;;
    -h | --help)
      echo "Usage: scripts/deploy [--db-only] [--allow-pending] [--tag SHA]"
      exit 0
      ;;
    *)
      echo "deploy: unknown argument $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -z ${BRINED_ALMANAC_OP_TOKEN:-} ]]; then
  if [[ -n ${BRINED_ALMANAC_AV_REEXEC:-} ]]; then
    echo "deploy: av inject ran but set no BRINED_ALMANAC_OP_TOKEN" >&2
    exit 1
  fi
  export BRINED_ALMANAC_AV_REEXEC=1
  exec av inject +BRINED_ALMANAC_OP_TOKEN -- "$0" ${args[@]+"${args[@]}"}
fi

cd "$(git rev-parse --show-toplevel)"

# The project name comes from compose.prod.yaml; mise's dev COMPOSE_PROJECT_NAME would override it.
unset COMPOSE_PROJECT_NAME

if [[ -n $(git status --porcelain) ]]; then
  echo "deploy: working tree is dirty" >&2
  exit 1
fi
branch=$(git rev-parse --abbrev-ref HEAD)
[[ $branch == main ]] || echo "deploy: warning, deploying from branch $branch, not main" >&2
tag=${tag:-$(git rev-parse --short HEAD)}
echo "deploy: tree clean on $branch, tag $tag"

STATE=${BRINED_ALMANAC_STATE:-$HOME/.local/share/brined-almanac}
export BRINED_ALMANAC_STATE=$STATE
missing=()
for f in prod.env known_hosts transcripts; do
  [[ -e $STATE/$f ]] || missing+=("$f")
done
if ((${#missing[@]})); then
  echo "deploy: missing in $STATE: ${missing[*]}; see $runbook" >&2
  exit 1
fi
if ! grep -q '^TASKCHAMPION_SYNC_URL=.' "$STATE/prod.env"; then
  echo "deploy: $STATE/prod.env has no TASKCHAMPION_SYNC_URL= line with a value; see $runbook" >&2
  exit 1
fi
echo "deploy: state dir ok ($STATE)"

# The private tier declarations live in the vault, not the repo; compose mounts this copy.
# --db-only starts no almanac, so it skips the fetch.
if ((!db_only)); then
  if ! (umask 077; OP_SERVICE_ACCOUNT_TOKEN=$BRINED_ALMANAC_OP_TOKEN op document get tiers.toml --vault brined-almanac --out-file "$STATE/tiers.toml" --force); then
    echo "deploy: could not fetch tiers.toml from the brined-almanac vault; see $runbook" >&2
    exit 1
  fi
  echo "deploy: fetched tiers.toml"
  # The daemon reads tiers once at startup and compose recreates a container only when its config
  # changes, so the file's hash goes into the config: a vault edit then recreates the daemon.
  BRINED_ALMANAC_TIERS_SHA256=$(shasum -a 256 "$STATE/tiers.toml")
  export BRINED_ALMANAC_TIERS_SHA256=${BRINED_ALMANAC_TIERS_SHA256%% *}
fi

# ps and exec interpolate the whole file, so the :? guards need values; neither recreates containers.
compose() {
  BRINED_ALMANAC_GITHUB_TOKEN=unused BRINED_ALMANAC_GITHUB_ALERTS_TOKEN=unused BRINED_ALMANAC_PULLER_KEY=unused BRINED_ALMANAC_TIERS_SHA256=unused \
    BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=unused BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=unused BRINED_ALMANAC_BUGSINK_DSN=unused BRINED_ALMANAC_BUGSINK_API_TOKEN=unused \
    docker compose -f compose.prod.yaml "$@"
}

# An event the running binary admitted but has not run yet fails under a binary with a different
# payload shape, and its delivery id stays seen, so it never runs (ivy/almanac#10).
if [[ -n $(compose ps -q --status running db 2>/dev/null) ]]; then
  pending=$(compose exec -T db psql -U almanac -d almanac -tAc 'select count(*) from pending')
  if [[ $pending != 0 && $allow_pending == 0 ]]; then
    echo "deploy: $pending event(s) wait in prod's pending table; let them run on the current binary first, or pass --allow-pending to deploy anyway (ivy/almanac#10)" >&2
    exit 1
  fi
  echo "deploy: $pending pending event(s) in prod"
fi

docker build -f Containerfile -t "brined-almanac:$tag" -t brined-almanac:prod .
docker build -f puller/Containerfile -t "brined-almanac-puller:$tag" -t brined-almanac-puller:prod puller/
echo "deploy: built brined-almanac:$tag and brined-almanac-puller:$tag (tagged prod)"

if ((db_only)); then
  BRINED_ALMANAC_GITHUB_TOKEN=unused BRINED_ALMANAC_GITHUB_ALERTS_TOKEN=unused BRINED_ALMANAC_PULLER_KEY=unused BRINED_ALMANAC_TIERS_SHA256=unused \
    BRINED_ALMANAC_TASKCHAMPION_CLIENT_ID=unused BRINED_ALMANAC_TASKCHAMPION_ENCRYPTION_SECRET=unused BRINED_ALMANAC_BUGSINK_DSN=unused BRINED_ALMANAC_BUGSINK_API_TOKEN=unused \
    docker compose -f compose.prod.yaml up -d --wait db
  echo "deploy: db is up; run mise run deploy for the rest"
  exit 0
fi

OP_SERVICE_ACCOUNT_TOKEN=$BRINED_ALMANAC_OP_TOKEN \
  op run --env-file prod.secrets.env -- docker compose -f compose.prod.yaml up -d --wait
echo "deploy: stack is up"

# Pulls the real history into a throwaway replica, so a wrong URL, client id or secret fails the
# deploy instead of the first filing. The stack is already up; the failure leaves it running.
if ! compose exec -T almanac brined-almanac sync-check; then
  echo "deploy: taskchampion sync-check failed; the stack is up but cannot file tasks, see $runbook" >&2
  exit 1
fi

compose ps
curl -fsS http://127.0.0.1:8788/healthz
echo
