#!/usr/bin/env bash
set -euo pipefail

# Usage: scripts/link-local <primary-checkout> <worktree>
#
# Symlinks the gitignored config in the primary checkout's local/ into a new worktree, so the
# worktree's hooks and runs see the same private files. Without local/forbidden-strings the
# pre-commit forbidden check skips its literal half, and without local/tiers.toml a run loses
# the private tier declarations. The rest of local/ is per-checkout scratch and stays apart.
#
# worktrunk runs this as a pre-start hook (.config/wt.toml). A file the primary doesn't have
# is skipped, and a file already in the worktree is left alone, so a rerun changes nothing.

shared=(forbidden-strings tiers.toml)

primary=${1:?usage: link-local <primary-checkout> <worktree>}
worktree=${2:?usage: link-local <primary-checkout> <worktree>}
primary=$(cd "$primary" && pwd)
worktree=$(cd "$worktree" && pwd)

if [ "$primary" = "$worktree" ]; then
  exit 0
fi

mkdir -p "$worktree/local"
for name in "${shared[@]}"; do
  source="$primary/local/$name"
  target="$worktree/local/$name"
  if [ ! -e "$source" ]; then
    echo "link-local: $source not found, skipping $name"
    continue
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    continue
  fi
  ln -s "$source" "$target"
  echo "link-local: linked local/$name"
done
